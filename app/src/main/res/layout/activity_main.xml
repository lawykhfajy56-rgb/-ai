<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8FAFC"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:justifyContent="space_between">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#0F172A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clearChatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مسح"
            android:textSize="12sp"
            android:backgroundTint="#DC2626" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/status_ready"
        android:textColor="#475569"
        android:textSize="14sp"
        android:gravity="center" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <EditText
            android:id="@+id/promptInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="اكتب رسالتك بالعربية..."
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:padding="12dp"
            android:background="#E2E8F0"
            android:gravity="center_vertical|end" />

        <ImageButton
            android:id="@+id/voiceButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:backgroundTint="#0F172A"
            android:contentDescription="voice" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/sendButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="إرسال"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/speakButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="اقرأ"
            android:backgroundTint="#16A34A"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/startCloudButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="☁️ تفعيل"
            android:backgroundTint="#9333EA"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
