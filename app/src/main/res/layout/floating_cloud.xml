<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:id="@+id/contentPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/cloud_panel_background"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="كلودي"
            android:textColor="#1E293B"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="أنا مساعدك الشخصي، جاهز للمحادثة العربية."
            android:textColor="#334155"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/closeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="إغلاق السحابة"
            android:backgroundTint="#0F172A"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <Button
        android:id="@+id/cloudButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/cloud_button_background"
        android:text="☁️"
        android:textSize="32sp"
        android:textColor="#0F172A" />
</LinearLayout>
